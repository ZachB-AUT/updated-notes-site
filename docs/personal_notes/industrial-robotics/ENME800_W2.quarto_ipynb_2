        "        case 'y':\n",
        "            return np.array([[np.cos(angle), 0, np.sin(angle)],\n",
        "                                [0, 1, 0],\n",
        "                                [-np.sin(angle), 0, np.cos(angle)]])\n",
        "        case 'z':\n",
        "            return np.array([[np.cos(angle), -np.sin(angle), 0],\n",
        "                             [np.sin(angle), np.cos(angle), 0],\n",
        "                             [0, 0, 1]])\n",
